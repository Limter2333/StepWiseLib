# StepWiseLib 环境变量配置
# 将敏感信息放在这里，而不是直接写在 application.yml 中

# 通义千问 API Key
DASHSCOPE_API_KEY=API_KEY

# 模型配置
DASHSCOPE_MODEL=qwen3-max-2026-01-23

# 模型参数
DASHSCOPE_TEMPERATURE=0.7
DASHSCOPE_MAX_TOKENS=2000
DASHSCOPE_TOP_P=0.9
DASHSCOPE_ENABLE_SEARCH=false

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rag_db
DB_USERNAME=root
DB_PASSWORD=password

# MCP 服务配置
MCP_SERVER_URL=http://localhost:8688
MCP_TIMEOUT=30000

# Excel 导出路径
EXCEL_EXPORT_PATH=./exports
