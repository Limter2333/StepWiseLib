# AI Multi-Agent System 环境配置示例
# 复制此文件为 .env 并修改相应值

# ========== API 配置 ==========
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ========== LLM 配置 ==========
# LLM提供商: minimax / anthropic / openai / deepseek
LLM_PROVIDER=minimax
# MiniMax配置
# 注意: MiniMax使用 anthropic_api_key 环境变量名
ANTHROPIC_API_KEY=your_minimax_api_key_here
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_MODEL=MiniMax-M2.7
# Anthropic配置 (备用)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-sonnet-20240229

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ========== 向量数据库配置 ==========
# ChromaDB (开发/学习用)
CHROMA_PERSIST_DIR=G:/claude_code_project/data/chromadb
CHROMA_COLLECTION_NAME=knowledge_base

# Milvus (生产用)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
# MILVUS_USER=
# MILVUS_PASSWORD=

# ========== 文档解析配置 ==========
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ========== RAG配置 ==========
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.5

# ========== Token配置 ==========
MAX_TOKENS_PER_CYCLE=1500
TOKEN_RESET_HOURS=5

# ========== 安全配置 ==========
GUARDRAIL_ENABLED=true
MAX_INPUT_LENGTH=10000

# ========== 日志配置 ==========
LOG_LEVEL=INFO
