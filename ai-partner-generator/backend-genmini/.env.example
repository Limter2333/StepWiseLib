# Genmini API 配置（可选，因为默认使用本地服务）
GENMINI_BASE_URL=http://localhost:3000

# 聊天模型配置（可选）
GENMINI_CHAT_MODEL=genmini-chat-v1

# 图片生成模型配置（可选）
GENMINI_IMAGE_MODEL=genmini-image-v1

# API Key 配置（可选，如果 Genmini 服务需要认证）
# 如果服务需要 API Key 认证，请取消注释并填写你的 API Key
GENMINI_API_KEY=your-api-key-here

# API Key 请求头名称（可选，默认为 Authorization）
# GENMINI_API_KEY_HEADER=Authorization

# API Key 前缀（可选，默认为 Bearer ）
# 常见的前缀有：Bearer, Token, Basic 等，如果不需要前缀可设置为空字符串
# GENMINI_API_KEY_PREFIX=Bearer 

# 日志级别配置（可选）
LOG_LEVEL_GENMINI=DEBUG
