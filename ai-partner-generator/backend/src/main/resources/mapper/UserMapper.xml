<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.sheven.partner.mapper.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.github.sheven.partner.model.User">
        <id column="id" property="id"/>
        <result column="user_uuid" property="userUuid"/>
        <result column="gender" property="gender"/>
        <result column="mbti_type" property="mbtiType"/>
        <result column="birth_date" property="birthDate"/>
        <result column="zodiac_sign" property="zodiacSign"/>
        <result column="birth_time" property="birthTime"/>
        <result column="birth_place" property="birthPlace"/>
        <result column="current_residence" property="currentResidence"/>
        <result column="interests" property="interests"/>
        <result column="custom_features" property="customFeatures"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 根据 UUID 查询用户 -->
    <select id="selectByUserUuid" resultMap="BaseResultMap">
        SELECT * FROM user_profile WHERE user_uuid = #{userUuid}
    </select>

</mapper>
